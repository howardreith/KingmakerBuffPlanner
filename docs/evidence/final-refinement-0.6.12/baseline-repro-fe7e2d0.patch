+        private static string ReproOutcome(RepeatSession run)
+        {
+            var r = run.Host.LastReport;
+            return "confirmed=" + r.Confirmed + ";skipped=" + r.Skipped + ";notProcessed=" + r.NotProcessed +
+                ";spent=" + r.ResourcesSpent + ";fired=" + string.Join(",", run.World.State.Fired.ToArray()) +
+                ";first=" + r.Entries[0].Detail;
+        }
+
+        private static void ReproH1(string root, string mode)
+        {
+            var run = new RepeatSession(root, mode, "r1", capturedHeroism: true, infectiousCharms: true, nearbyRecipients: true);
+            run.World.MarkerLifetime = 1; // Call of the Wild applies both markers for 3 seconds
+            RepeatAssert(run.Apply().Allowed && run.Host.LastReport.Confirmed == 2, "first: " + ReproOutcome(run));
+            int slots = run.World.State.Tokens.Values.Count(v => v);
+            run.World.Round += 1; // markers expired; Heroism has 99 rounds left
+            run.World.State.Active.Remove("unit-t4");
+            RepeatAssert(run.Apply().Allowed, "repeat admission");
+            Console.WriteLine("[BASELINE-REPRO-H1] mode=" + mode + ";heroism-slots-before=" + slots + ";after=" +
+                run.World.State.Tokens.Values.Count(v => v) + ";" + ReproOutcome(run));
+            RepeatAssert(run.Host.LastReport.Skipped == 1 && run.World.State.Tokens.Values.Count(v => v) == slots,
+                "H1 reproduced: adequate long Heroism was recast because its 3 s markers expired");
+        }
+
+        private static void ReproH2(string root, string mode)
+        {
+            var run = new RepeatSession(root, mode, "r2", capturedHeroism: true, infectiousCharms: true, nearbyRecipients: true);
+            run.World.ApplicationOwner = "unit-t3"; // predicted unit-t2; unit-t3 is nearest when the action runs
+            RepeatAssert(run.Apply(true).Allowed, "admission");
+            Console.WriteLine("[BASELINE-REPRO-H2] mode=" + mode + ";predicted=unit-t2;applied=unit-t3;" + ReproOutcome(run));
+            RepeatAssert(run.Host.LastReport.Confirmed == 2 && run.Host.LastReport.NotProcessed == 0,
+                "H2 reproduced: legitimate native A->B selection failed confirmation and stopped the successor");
+        }
